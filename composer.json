{
  "name": "ussmarines/pixcensus-media-audit",
  "description": "Development tooling for the PixCensus — Media Usage Audit WordPress plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "ussmarines",
      "homepage": "https://github.com/ussmarines"
    }
  ],
  "require": {},
  "require-dev": {
    "php-stubs/wordpress-stubs": "7.0.1",
    "phpcompatibility/php-compatibility": "9.3.5",
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "phpstan/phpstan": "2.2.7",
    "phpunit/phpunit": "9.6.35",
    "squizlabs/php_codesniffer": "3.13.6",
    "wp-coding-standards/wpcs": "3.4.1",
    "yoast/phpunit-polyfills": "4.0.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist",
    "lint:fix": "phpcbf --standard=phpcs.xml.dist",
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
    "test": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist --testsuite=unit",
    "qa": [
      "@lint",
      "@analyse",
      "@test"
    ]
  }
}
